(executable
 (name main)
 (libraries shelter_server shelter_shared kre kre-db-mariadb dream lwt)
 (preprocess
  (pps kre-ppx))
 (preprocessor_deps
  (source_tree ..)))

(rule
 (targets spec.json)
 (action
  (setenv
   JWT_SECRET
   unused
   (setenv
    DATABASE_URL
    unused
    (run %{exe:main.exe} --emit-spec %{targets})))))
