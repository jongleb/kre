let root = Kre_client.Router.root ~layout:Pages.layout ()

module Cats = struct
  type params = { id : Cat.Id.t } [@@deriving params ~path:"/cats/:id"]

  let show =
    Kre_client.Router.child ~live:Cats_client.Live.find_one root
      ~path:params_path ~search:Kre_shared.Search.none
      ~loader:(fun { id } () -> Cats_client.find_one ~cat:id)
      ~component:Pages.cat

  let index =
    Kre_client.Router.child ~live:Cats_client.Live.available root
      ~path:[%path "/cats"] ~search:Kre_shared.Search.none
      ~loader:(fun () () -> Cats_client.available ())
      ~component:
        (Pages.cats ~link:(fun (cat : Cat.t) children ->
             Kre_client.Router.link show ~params:{ id = cat.id } ~search:()
               ~children))
end

let adoptions =
  Kre_client.Router.child ~live:Adoptions_client.Live.mine root
    ~path:[%path "/adoptions"] ~search:Kre_shared.Search.none
    ~loader:(fun () () -> Adoptions_client.mine ())
    ~component:Pages.adoptions

let login =
  Kre_client.Router.child root ~path:[%path "/login"]
    ~search:Kre_shared.Search.none ~loader:Kre_client.Router.no_data
    ~component:(fun ~data:() ~params:() ~search:() ->
      <Pages.Login
        on_login=(fun (session : Session.t) ->
                     Kre_client.Http.headers :=
                       [ ("Authorization", "Bearer " ^ session.token) ];
                     Kre_client.Router.navigate Cats.index ~params:() ~search:())
      />)

let router =
  Kre_client.Router.make
    [ Any Cats.index; Any Cats.show; Any adoptions; Any login ]
