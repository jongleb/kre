(rule
 (targets auth_client.ml cats_client.ml adoptions_client.ml)
 (deps ../bin/spec.json)
 (action
  (progn
   (run
    %{bin:forge}
    client
    --spec
    ../bin/spec.json
    --controller
    auth
    --out
    auth_client.ml)
   (run
    %{bin:forge}
    client
    --spec
    ../bin/spec.json
    --controller
    cats
    --out
    cats_client.ml)
   (run
    %{bin:forge}
    client
    --spec
    ../bin/spec.json
    --controller
    adoptions
    --out
    adoptions_client.ml))))

(library
 (name shelter_client)
 (modes melange)
 (libraries
  shelter_shared_js
  forge-client
  forge-client.shared
  jsonkit-melange
