(rule
 (targets schema.sql)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:schema.exe}))))

(rule
 (targets crud.sql)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:schema.exe} crud))))

(rule
 (targets cats_crud.ml)
 (deps schema.sql crud.sql)
 (action
  (with-stdout-to
   %{targets}
   (run
    sqlgg
    -dialect
    mysql
    -gen
    caml_io
    -name
    Make
    -static-header
    schema.sql
    crud.sql))))

(rule
 (targets cats_sql.ml)
 (deps schema.sql queries/cats.sql)
 (action
  (with-stdout-to
   %{targets}
   (run
    sqlgg
    -dialect
    mysql
    -gen
    caml_io
    -name
    Make
    -static-header
    schema.sql
    queries/cats.sql))))

(executable
 (name schema)
 (modules schema)
 (libraries cats_shared kre))

(library
 (name cats_db)
 (wrapped false)
 (modules cats_sql cats_crud cats_db_service batch_controller database)
 (flags
  (:standard -w -32-27))
 (libraries cats_server cats_shared kre kre-db-mariadb sqlgg.traits lwt)
 (preprocess
  (per_module
   ((pps lwt_ppx)
    cats_db_service)
   ((pps lwt_ppx kre-ppx)
    batch_controller
    database)))
 (preprocessor_deps
  (glob_files migrations/*.sql)))
