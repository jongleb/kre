let () =
  Kre_client.Http.headers := [ ("X-User", "web") ];
  Option.iter
    (fun root ->
      ReactDOM.Client.render
        (ReactDOM.Client.createRoot root)
        <Kre_client.Router.View
          router=Cats_client_js.Routes.router pending=(React.string "Loading…")
        />)
    (ReactDOM.querySelector "#root")
