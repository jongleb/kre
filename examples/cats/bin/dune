(executable
 (name main)
 (modules main web)
 (libraries cats_server cats_shared cats_db kre kre-db-mariadb dream lwt)
 (preprocess
  (pps kre-ppx))
 (preprocessor_deps
  (source_tree ..)))

(rule
 (targets openapi.json)
 (action
  (setenv
   SESSION_SECRET
   unused
   (setenv
    DATABASE_URL
    unused
    (run %{exe:main.exe} --emit-openapi %{targets})))))
