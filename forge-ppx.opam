# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Forge ppx: controller, dto, config, table"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "ISC"
homepage: "https://github.com/jongleber/forge"
bug-reports: "https://github.com/jongleber/forge/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.5" & < "5.6"}
  "ppxlib" {>= "0.38.0"}
  "jsonkit" {>= "1.1.0"}
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleber/forge.git"
x-maintenance-intent: ["(latest)"]
