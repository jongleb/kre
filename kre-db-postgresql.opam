# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "PostgreSQL driver (libpq) and sqlgg traits for Kre.Db"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "ISC"
homepage: "https://github.com/jongleber/forge"
bug-reports: "https://github.com/jongleber/forge/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.5" & < "5.6"}
  "kre" {= version}
  "postgresql" {>= "5.0"}
  "sqlgg" {>= "20260721"}
  "integers"
  "yojson"
  "lwt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleber/forge.git"
x-maintenance-intent: ["(latest)"]
