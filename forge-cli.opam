# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The forge command-line tool"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "ISC"
homepage: "https://github.com/jongleber/forge"
bug-reports: "https://github.com/jongleber/forge/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.5" & < "5.6"}
  "cmdliner" {>= "2.0.0"}
  "forge" {= version}
  "yojson"
  "dream"
  "forge-db-mariadb" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleber/forge.git"
x-maintenance-intent: ["(latest)"]
