module type S = sig
  val add : Create_{{singular}}_dto.t -> {{Singular}}.t Lwt.t
  val find_all : unit -> {{Singular}}.t list Lwt.t
  val find : {{Singular}}.Id.t -> {{Singular}}.t option Lwt.t
  val remove : {{Singular}}.Id.t -> unit Lwt.t
end

module Make () = struct
  let {{plural}} : {{Singular}}.t list ref = ref []
  let last_id = ref None

  let add ({ {{names}} } : Create_{{singular}}_dto.t) =
    let id = Option.fold ~none:{{Singular}}.Id.first ~some:{{Singular}}.Id.succ !last_id in
    last_id := Some id;
    let {{singular}} = { {{Singular}}.id; {{names}} } in
    {{plural}} := !{{plural}} @ [ {{singular}} ];
    Lwt.return {{singular}}

  let find_all () = Lwt.return !{{plural}}

  let find id =
    Lwt.return
      (List.find_opt
         (fun ({{singular}} : {{Singular}}.t) -> {{Singular}}.Id.equal {{singular}}.id id)
         !{{plural}})

  let remove id =
    {{plural}} :=
      List.filter
        (fun ({{singular}} : {{Singular}}.t) -> not ({{Singular}}.Id.equal {{singular}}.id id))
        !{{plural}};
    Lwt.return_unit
end

include Make ()
